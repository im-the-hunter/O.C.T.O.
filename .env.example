# ============================================================
# Project J.A.R.V.I.S. — Variables de entorno (.env.example)
# Copia este archivo a .env (frontend y backend) y completa los valores.
#   cp .env.example frontend/.env.local
#   cp .env.example backend/.env
# ============================================================

# --- OpenAI (GPT-4o) ---
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Pinecone (Base de datos vectorial / RAG) ---
PINECONE_API_KEY=pcsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PINECONE_ENVIRONMENT=us-east-1-aws
PINECONE_INDEX_NAME=jarvis-repo
EMBEDDING_DIMENSIONS=1536

# --- RAG / Ingesta vectorial (Fase 5) ---
RAG_CHUNK_TOKENS=500
RAG_CHUNK_OVERLAP_TOKENS=50
RAG_MIN_SCORE=0.70
RAG_TOP_K_DEFAULT=5
RAG_ANSWER_CACHE_TTL=3600
# Re-ranking opcional con Cohere (si se omite, se usa re-ranking heurístico + BM25)
COHERE_API_KEY=
COHERE_RERANK_MODEL=rerank-english-v3.0

# --- GitHub API (lectura e ingesta del repositorio) ---
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_REPO_OWNER=tonystark
GITHUB_REPO_NAME=jarvis-core

# --- PostgreSQL (memoria a largo plazo) ---
DATABASE_URL=postgresql://jarvis:jarvis_password@localhost:5432/jarvis_db
# URL async para SQLAlchemy + asyncpg (derivada de la anterior)
DATABASE_URL_ASYNC=postgresql+asyncpg://jarvis:jarvis_password@localhost:5432/jarvis_db

# --- NextAuth.js (autenticación) ---
NEXTAUTH_SECRET=genera_un_secreto_con: openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000
# Provider opcional de GitHub para login
GITHUB_CLIENT_ID=Iv1.xxxxxxxxxxxxxxxx
GITHUB_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Backend FastAPI ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
NEXT_PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Webhooks de GitHub (Fase 4) ---
# Secret usado para firmar/validar payloads HMAC-SHA256 de POST /webhook/github
GITHUB_WEBHOOK_SECRET=

# --- Voz (Fase 3, opcional: calidad premium del TTS) ---
# Si se define, el frontend usa ElevenLabs en lugar de la Web Speech API
NEXT_PUBLIC_ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
